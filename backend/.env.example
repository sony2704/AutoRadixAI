# AutoRadixAI Backend — Environment Variables
# Copy this to .env and fill in production values

# Application
APP_NAME=AutoRadixAI
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# Security — CHANGE THESE IN PRODUCTION
SECRET_KEY=your-super-secret-key-change-this-to-64-random-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=["http://localhost:3000","https://your-domain.com"]

# Database
DATABASE_URL=postgresql+asyncpg://autoradix:autoradix@postgres:5432/autoradixai
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# File Storage
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
MAX_UPLOAD_SIZE_MB=500

# S3 (optional)
USE_S3=false
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=autoradixai

# AI / ML
GPU_ENABLED=false
GPU_DEVICE_ID=0
INFERENCE_TIMEOUT_SECONDS=120
MODEL_REGISTRY_PATH=ai-models/registry
MODEL_WEIGHTS_PATH=ai-models/weights

# PACS / Orthanc (optional)
ORTHANC_URL=http://orthanc:8042
ORTHANC_USER=orthanc
ORTHANC_PASSWORD=orthanc

# FHIR (optional)
FHIR_SERVER_URL=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/autoradixai.log
